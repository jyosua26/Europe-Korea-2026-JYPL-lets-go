<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="J·P·T Journey">
<meta name="theme-color" content="#2A2E2B">
<title>Jonathan, Priscilla &amp; Theodore — Europe &amp; Korea</title>
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' fill='%232A2E2B'/%3E%3Ctext x='90' y='103' font-family='Georgia,serif' font-size='58' fill='%23B2925E' text-anchor='middle'%3EJPT%3C/text%3E%3C/svg%3E">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'%3E%3Crect width='180' height='180' fill='%232A2E2B'/%3E%3Ctext x='90' y='103' font-family='Georgia,serif' font-size='58' fill='%23B2925E' text-anchor='middle'%3EJPT%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --stone:#EAE2D3;
    --paper:#F8F4EC;
    --paper-2:#F1EADB;
    --ink:#201E17;
    --ink-soft:#6B6558;
    --ink-faint:#9C9585;
    --brass:#A8875A;
    --brass-deep:#7E6339;
    --brass-pale:#D9C6A2;
    --line:rgba(32,30,23,0.14);
    --line-soft:rgba(32,30,23,0.08);
    --deep:#2A2E2B;
    --deep-2:#343935;
    --cream-on-deep:#EFE7D6;
    --radius:2px;
    --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-top: env(safe-area-inset-top, 0px);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--stone);
    color:var(--ink);
    font-family:'Jost',sans-serif;
    font-weight:300;
    -webkit-font-smoothing:antialiased;
    overscroll-behavior-y:none;
  }
  ::selection{background:var(--brass-pale);}
  h1,h2,h3,.serif{font-family:'Cormorant Garamond',serif;font-weight:400;}
  .eyebrow{
    font-family:'Jost',sans-serif;
    font-size:10.5px;
    letter-spacing:0.22em;
    text-transform:uppercase;
    color:var(--ink-faint);
    font-weight:500;
  }
  a{color:inherit;text-decoration:none;}

  /* ---------- App shell ---------- */
  #app{
    max-width:560px;
    margin:0 auto;
    min-height:100vh;
    background:var(--stone);
    position:relative;
    padding-bottom:calc(78px + var(--safe-bottom));
  }

  /* ---------- Header ---------- */
  header.top{
    position:sticky;
    top:0;
    z-index:40;
    background:var(--deep);
    color:var(--cream-on-deep);
    padding-top:var(--safe-top);
  }
  .top-inner{
    padding:22px 22px 16px;
    text-align:center;
    position:relative;
  }
  .monogram{
    font-family:'Cormorant Garamond',serif;
    font-size:13px;
    letter-spacing:0.42em;
    color:var(--brass);
    text-transform:uppercase;
    margin-bottom:8px;
  }
  .trip-title{
    font-family:'Cormorant Garamond',serif;
    font-weight:400;
    font-size:26px;
    line-height:1.15;
    letter-spacing:0.01em;
    margin:0 0 6px;
  }
  .trip-title em{font-style:italic;color:var(--brass-pale);}
  .trip-dates{
    font-size:11px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:rgba(239,231,214,0.55);
    font-weight:400;
  }
  .hairline{
    height:1px;
    background:linear-gradient(90deg, transparent, rgba(178,146,94,0.55), transparent);
    margin:16px auto 0;
    width:64px;
  }

  /* ---------- Sticky itinerary sub-header (legs + hero) ---------- */
  .itin-sticky{
    position:sticky;
    top:var(--header-h, 0px);
    z-index:35;
    background:var(--deep);
  }

  /* leg chip nav */
  nav.legs{
    display:flex;
    gap:0;
    overflow-x:auto;
    padding:14px 12px;
    scrollbar-width:none;
    background:var(--deep);
  }
  nav.legs::-webkit-scrollbar{display:none;}
  nav.legs a{
    flex:0 0 auto;
    padding:7px 14px;
    font-size:11px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:rgba(239,231,214,0.5);
    border:1px solid rgba(239,231,214,0.16);
    border-radius:20px;
    margin-right:8px;
    white-space:nowrap;
    transition:all .25s ease;
    font-family:'Jost',sans-serif;
  }
  nav.legs a.active{
    color:var(--deep);
    background:var(--brass);
    border-color:var(--brass);
  }

  /* city hero band */
  .city-hero{
    position:relative;
    height:196px;
    overflow:hidden;
    background:var(--deep-2);
  }
  .city-hero .hero-img{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    opacity:0;
    transition:opacity 1.1s ease;
    filter:saturate(0.86) contrast(1.03);
  }
  .city-hero .hero-img.on{opacity:1;}
  .hero-overlay{
    position:absolute;
    inset:0;
    background:
      linear-gradient(180deg, rgba(22,21,15,0.15) 0%, rgba(22,21,15,0.05) 35%, rgba(22,21,15,0.75) 100%),
      linear-gradient(90deg, rgba(22,21,15,0.35) 0%, transparent 45%);
  }
  .hero-text{
    position:absolute;
    left:20px;
    right:20px;
    bottom:16px;
    color:var(--cream-on-deep);
  }
  .hero-eyebrow{
    font-size:10px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--brass-pale);
    margin-bottom:4px;
    opacity:0.9;
  }
  .hero-city{
    font-family:'Cormorant Garamond',serif;
    font-size:34px;
    line-height:1;
    text-shadow:0 2px 18px rgba(0,0,0,0.35);
  }

  /* ---------- Screens ---------- */
  .screen{display:none;}
  .screen.active{display:block;}

  /* ---------- Section divider ---------- */
  .section-divider{
    padding:38px 26px 20px;
    text-align:center;
    position:relative;
  }
  .section-divider .flag{font-size:22px;display:block;margin-bottom:10px;letter-spacing:.3em;}
  .section-divider h2{
    font-size:29px;
    margin:0 0 6px;
    letter-spacing:0.01em;
  }
  .section-divider .sub{
    font-size:11px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--ink-soft);
  }
  .section-divider .rule{
    width:34px;height:1px;background:var(--brass);
    margin:14px auto 0;
  }

  /* ---------- Day card ---------- */
  .day{
    margin:0 16px 16px;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius);
    overflow:hidden;
  }
  .day-head{
    display:flex;
    align-items:flex-start;
    gap:14px;
    padding:20px 20px 16px;
  }
  .day-num{
    font-family:'Cormorant Garamond',serif;
    font-size:34px;
    color:var(--brass);
    line-height:1;
    font-weight:400;
    min-width:44px;
  }
  .day-head-text{flex:1;min-width:0;}
  .day-date{
    font-size:10.5px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--ink-faint);
    margin-bottom:5px;
  }
  .day-dest{
    font-family:'Cormorant Garamond',serif;
    font-size:22px;
    line-height:1.2;
  }

  .flight-strip{
    margin:0 20px 16px;
    padding:11px 14px;
    background:var(--deep);
    color:var(--cream-on-deep);
    border-radius:var(--radius);
    font-size:12.5px;
    line-height:1.55;
    white-space:pre-line;
    font-weight:300;
  }
  .flight-strip .lbl{color:var(--brass);letter-spacing:.14em;font-size:9.5px;text-transform:uppercase;display:block;margin-bottom:5px;}

  .block{padding:0 20px 16px;}
  .block-label{
    font-size:10.5px;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--brass-deep);
    font-weight:500;
    margin-bottom:9px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .block-label::after{
    content:'';
    flex:1;
    height:1px;
    background:var(--line);
  }
  ul.plan{list-style:none;margin:0;padding:0;}
  ul.plan li{
    position:relative;
    padding-left:16px;
    margin-bottom:9px;
    font-size:14.5px;
    line-height:1.5;
    color:var(--ink);
  }
  ul.plan li:last-child{margin-bottom:0;}
  ul.plan li::before{
    content:'';
    position:absolute;
    left:0;top:8px;
    width:4px;height:4px;
    background:var(--brass);
    border-radius:50%;
  }
  .rating{
    display:inline-block;
    margin-left:6px;
    font-size:11.5px;
    color:var(--brass-deep);
    font-family:'Jost',sans-serif;
    white-space:nowrap;
  }
  .free-tag{
    display:inline-block;
    margin-left:6px;
    font-size:9px;
    letter-spacing:.1em;
    color:var(--brass-deep);
    border:1px solid var(--brass-pale);
    border-radius:10px;
    padding:1px 6px;
    text-transform:uppercase;
    vertical-align:middle;
  }

  .meals{display:flex;gap:12px;padding:0 20px 4px;}
  .meal{flex:1;min-width:0;}
  .meal .block-label{margin-bottom:8px;}
  .meal ul.plan li{font-size:13.5px;}

  details.alt{
    margin:6px 20px 16px;
    border-top:1px dashed var(--line);
    padding-top:12px;
  }
  details.alt summary{
    list-style:none;
    cursor:pointer;
    font-size:10.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--ink-faint);
    display:flex;
    align-items:center;
    gap:6px;
  }
  details.alt summary::-webkit-details-marker{display:none;}
  details.alt summary::before{
    content:'+';
    font-family:'Cormorant Garamond',serif;
    font-size:15px;
    color:var(--brass);
    line-height:1;
  }
  details.alt[open] summary::before{content:'–';}
  details.alt .alt-body{padding-top:12px;}
  details.alt .alt-body ul.plan li{color:var(--ink-soft);font-size:13px;}
  details.alt .alt-body ul.plan li::before{background:var(--ink-faint);}
  details.alt .alt-body .meals{padding:0;margin-top:10px;}

  .day-foot{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    padding:14px 20px;
    background:var(--paper-2);
    border-top:1px solid var(--line);
  }
  .stay-pill{
    font-size:12px;
    color:var(--ink-soft);
    display:flex;
    align-items:center;
    gap:7px;
    min-width:0;
  }
  .stay-pill .dot{width:5px;height:5px;border-radius:50%;background:var(--brass);flex:0 0 auto;}
  .stay-pill span.name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

  details.notes{flex:0 0 auto;}
  details.notes summary{
    list-style:none;
    cursor:pointer;
    font-size:10px;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--brass-deep);
    border:1px solid var(--brass-pale);
    border-radius:20px;
    padding:5px 11px;
    white-space:nowrap;
  }
  details.notes summary::-webkit-details-marker{display:none;}
  .notes-body{
    padding:14px 20px 4px;
    font-size:12.5px;
    line-height:1.65;
    color:var(--ink-soft);
    white-space:pre-line;
    background:var(--paper-2);
    border-top:1px solid var(--line);
  }

  /* ---------- Flights screen ---------- */
  .page-title{padding:34px 24px 6px;text-align:center;}
  .page-title h2{font-size:28px;margin:0 0 8px;}
  .page-title .rule{width:34px;height:1px;background:var(--brass);margin:12px auto 0;}

  .flight-card{
    margin:14px 16px;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:18px 20px;
  }
  .flight-card .fc-top{
    display:flex;justify-content:space-between;align-items:baseline;
    margin-bottom:10px;
  }
  .fc-route{font-family:'Cormorant Garamond',serif;font-size:19px;}
  .fc-num{font-size:11px;letter-spacing:.1em;color:var(--brass-deep);text-transform:uppercase;}
  .fc-meta{
    display:flex;flex-wrap:wrap;gap:6px 16px;
    font-size:12px;color:var(--ink-soft);
    padding-top:10px;margin-top:10px;
    border-top:1px solid var(--line-soft);
  }
  .fc-meta b{color:var(--ink);font-weight:500;}
  .fc-notes{margin-top:10px;font-size:12px;color:var(--ink-faint);font-style:italic;}
  .bag-disclaimer{
    margin:16px 20px 4px;
    font-size:11.5px;
    line-height:1.6;
    color:var(--ink-faint);
    text-align:center;
    font-style:italic;
  }
  .fc-bags{
    margin-top:10px;
    padding-top:10px;
    border-top:1px solid var(--line-soft);
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .fc-bag-row{
    display:flex;
    gap:8px;
    font-size:12px;
    line-height:1.5;
  }
  .fc-bag-row .who{
    flex:0 0 58px;
    font-size:9.5px;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--brass-deep);
    padding-top:1px;
  }
  .fc-bag-row .what{color:var(--ink-soft);}

  /* ---------- Stays screen ---------- */
  .stay-card{
    margin:14px 16px;
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px;
  }
  .stay-card h3{font-size:21px;margin:0 0 4px;line-height:1.2;white-space:pre-line;}
  .stay-city{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--brass-deep);margin-bottom:12px;}
  .stay-dates{display:flex;gap:22px;margin-bottom:12px;}
  .stay-dates div .k{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:3px;}
  .stay-dates div .v{font-size:13.5px;}
  .stay-cot{
    display:inline-block;
    font-size:11px;
    padding:4px 10px;
    border-radius:20px;
    border:1px solid var(--brass-pale);
    color:var(--brass-deep);
    margin-bottom:10px;
  }
  .stay-notes{font-size:12.5px;color:var(--ink-soft);line-height:1.6;}

  /* ---------- Tips screen ---------- */
  .tip-section{margin:0 16px 22px;}
  .tip-section h3{
    font-size:20px;
    padding-bottom:10px;
    margin:0 0 12px;
    border-bottom:1px solid var(--line);
  }
  .tip-item{
    margin-bottom:14px;
    padding-left:16px;
    border-left:2px solid var(--brass-pale);
  }
  .tip-item .t{font-size:13.5px;font-weight:500;color:var(--ink);margin-bottom:3px;}
  .tip-item .b{font-size:12.5px;color:var(--ink-soft);line-height:1.6;}

  footer.note{
    text-align:center;
    padding:30px 24px 10px;
    font-size:11px;
    letter-spacing:.08em;
    color:var(--ink-faint);
    line-height:1.7;
  }

  /* ---------- Bottom nav ---------- */
  nav.bottom{
    position:fixed;
    left:0;right:0;bottom:0;
    z-index:50;
    max-width:560px;
    margin:0 auto;
    background:var(--deep);
    display:flex;
    padding:10px 6px calc(10px + var(--safe-bottom));
    border-top:1px solid rgba(239,231,214,0.1);
  }
  nav.bottom button{
    flex:1;
    background:none;border:none;
    color:rgba(239,231,214,0.45);
    font-family:'Jost',sans-serif;
    font-size:10px;
    letter-spacing:.12em;
    text-transform:uppercase;
    padding:8px 4px 4px;
    display:flex;flex-direction:column;align-items:center;gap:6px;
  }
  nav.bottom button .ic{width:17px;height:17px;display:block;}
  nav.bottom button.active{color:var(--brass);}
  nav.bottom button svg{stroke:currentColor;fill:none;stroke-width:1.3;width:100%;height:100%;}

  @media (min-width:560px){
    #app{border-left:1px solid var(--line);border-right:1px solid var(--line);}
  }
</style>
</head>
<body>
<div id="app">

  <header class="top" id="topHeader">
    <div class="top-inner">
      <div class="monogram">J · P · T</div>
      <h1 class="trip-title">Europe <em>&amp;</em> Korea</h1>
      <div class="trip-dates">6 — 29 September 2026</div>
      <div class="hairline"></div>
    </div>
  </header>

  <main>
    <section class="screen active" id="screen-itinerary">
      <div class="itin-sticky" id="itinSticky">
        <nav class="legs" id="legNav"></nav>
        <div class="city-hero" id="cityHero">
          <img class="hero-img" id="heroImgA" alt="">
          <img class="hero-img" id="heroImgB" alt="">
          <div class="hero-overlay"></div>
          <div class="hero-text">
            <div class="hero-eyebrow" id="heroEyebrow">Now arriving</div>
            <div class="hero-city" id="heroCity">Outbound</div>
          </div>
        </div>
      </div>
      <div id="itinDays"></div>
    </section>

    <section class="screen" id="screen-flights">
      <div class="page-title">
        <div class="eyebrow">In the air</div>
        <h2>Flight Summary</h2>
        <div class="rule"></div>
      </div>
      <div class="bag-disclaimer">Baggage figures are each airline's standard entitlement for the booked cabin — confirm exact numbers on your e-ticket, as fare type or status can raise them.</div>
      <div id="flightsList"></div>
      <footer class="note">Ten sectors, four countries.<br>Cathay Pacific · Finnair · SAS</footer>
    </section>

    <section class="screen" id="screen-stays">
      <div class="page-title">
        <div class="eyebrow">Where we lay our heads</div>
        <h2>Accommodation</h2>
        <div class="rule"></div>
      </div>
      <div id="staysList"></div>
      <footer class="note">Five stays, five cities.</footer>
    </section>

    <section class="screen" id="screen-tips">
      <div class="page-title">
        <div class="eyebrow">For Theodore</div>
        <h2>Travelling with an Infant</h2>
        <div class="rule"></div>
      </div>
      <div id="tipsList"></div>
      <footer class="note">Safe travels, always.</footer>
    </section>
  </main>

  <nav class="bottom" id="bottomNav">
    <button data-screen="itinerary" class="active">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
      Journey
    </button>
    <button data-screen="flights">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M2 16l20-7-4 15-5-6-5 4-1-5-5-1z"/></svg></span>
      Flights
    </button>
    <button data-screen="stays">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M3 21V9l9-6 9 6v12M8 21v-7h8v7"/></svg></span>
      Stays
    </button>
    <button data-screen="tips">
      <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.2"/><path d="M6 21c0-4 2.7-6 6-6s6 2 6 6"/></svg></span>
      Baby
    </button>
  </nav>

