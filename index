<script>
(function(){
  function syncHeaderHeight(){
    var h = document.getElementById('topHeader');
    if(h) document.documentElement.style.setProperty('--header-h', h.offsetHeight + 'px');
  }
  syncHeaderHeight();
  window.addEventListener('resize', syncHeaderHeight);
  window.addEventListener('orientationchange', syncHeaderHeight);

  var data = JSON.parse(document.getElementById('trip-data').textContent);

  var FLAGS = {
    "OUTBOUND": "✈",
    "LONDON": "🇬🇧",
    "LONDON → COPENHAGEN": "🇩🇰",
    "STOCKHOLM": "🇸🇪",
    "STOCKHOLM → HELSINKI": "🇫🇮",
    "SEOUL": "🇰🇷"
  };

  function flagFor(section){
    if(!section) return "✦";
    if(section.indexOf("OUTBOUND")===0) return "✈";
    if(section.indexOf("LONDON")===0 && section.indexOf("COPENHAGEN")===-1) return "🇬🇧";
    if(section.indexOf("COPENHAGEN")>-1) return "🇩🇰";
    if(section.indexOf("STOCKHOLM")===0) return "🇸🇪";
    if(section.indexOf("HELSINKI")>-1) return "🇫🇮";
    if(section.indexOf("SEOUL")>-1) return "🇰🇷";
    return "✦";
  }

  function shortLeg(section){
    if(!section) return "";
    if(section.indexOf("OUTBOUND")===0) return "Outbound";
    if(section.indexOf("LONDON")===0 && section.indexOf("COPENHAGEN")===-1) return "London";
    if(section.indexOf("COPENHAGEN")>-1) return "Copenhagen";
    if(section.indexOf("STOCKHOLM")===0) return "Stockholm";
    if(section.indexOf("HELSINKI")>-1) return "Helsinki";
    if(section.indexOf("SEOUL")>-1) return "Seoul";
    return section;
  }

  function esc(s){
    if(s===undefined || s===null) return "";
    return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
  }

  function itemsHtml(items){
    if(!items || !items.length) return "";
    return "<ul class='plan'>" + items.map(function(it){
      var rating = it.rating ? "<span class='rating'>★ "+esc(it.rating)+"</span>" : "";
      var free = it.free ? "<span class='free-tag'>Free</span>" : "";
      return "<li>"+esc(it.text)+rating+free+"</li>";
    }).join("") + "</ul>";
  }

  function mealsBlock(lp, lo, dp, dopt){
    var html = "<div class='meals'>";
    if(lp && lp.length){
      html += "<div class='meal'><div class='block-label'>Lunch</div>" + itemsHtml(lp) + "</div>";
    }
    if(dp && dp.length){
      html += "<div class='meal'><div class='block-label'>Dinner</div>" + itemsHtml(dp) + "</div>";
    }
    html += "</div>";
    return html;
  }

  function altMealsBlock(lo, dopt){
    var html = "";
    if((lo && lo.length) || (dopt && dopt.length)){
      html += "<div class='meals'>";
      if(lo && lo.length) html += "<div class='meal'><div class='block-label'>Lunch, also</div>"+itemsHtml(lo)+"</div>";
      if(dopt && dopt.length) html += "<div class='meal'><div class='block-label'>Dinner, also</div>"+itemsHtml(dopt)+"</div>";
      html += "</div>";
    }
    return html;
  }

  function dayCard(d){
    var num = String(d.day).padStart(2,'0');
    var flightHtml = "";
    if(d.flight){
      flightHtml = "<div class='flight-strip'><span class='lbl'>In transit</span>"+esc(d.flight)+"</div>";
    }

    var actHtml = "";
    if(d.activitiesPrimary && d.activitiesPrimary.length){
      actHtml = "<div class='block'><div class='block-label'>Today</div>"+itemsHtml(d.activitiesPrimary)+"</div>";
    }

    var mealsHtml = mealsBlock(d.lunchPrimary, d.lunchOptional, d.dinnerPrimary, d.dinnerOptional);

    var hasAlt = (d.activitiesOptional && d.activitiesOptional.length) ||
                 (d.lunchOptional && d.lunchOptional.length) ||
                 (d.dinnerOptional && d.dinnerOptional.length);

    var altHtml = "";
    if(hasAlt){
      altHtml = "<details class='alt'><summary>Also considered</summary><div class='alt-body'>";
      if(d.activitiesOptional && d.activitiesOptional.length){
        altHtml += itemsHtml(d.activitiesOptional);
      }
      altHtml += altMealsBlock(d.lunchOptional, d.dinnerOptional);
      altHtml += "</div></details>";
    }

    var notesHtml = "";
    if(d.notes){
      notesHtml = "<details class='notes'><summary>Notes</summary></details>";
    }

    var foot = "<div class='day-foot'>" +
        "<div class='stay-pill'><span class='dot'></span><span class='name'>"+esc(d.accommodation||"")+"</span></div>" +
        notesHtml +
      "</div>";

    var notesBody = d.notes ? "<div class='notes-body' style='display:none' data-notesbody>"+esc(d.notes)+"</div>" : "";

    return "<article class='day'>" +
      "<div class='day-head'><div class='day-num'>"+num+"</div>" +
        "<div class='day-head-text'><div class='day-date'>"+esc(d.date)+"</div>" +
        "<div class='day-dest'>"+esc(d.destination)+"</div></div></div>" +
      flightHtml +
      actHtml +
      mealsHtml +
      altHtml +
      foot +
      notesBody +
      "</article>";
  }

  // City hero images (Wikimedia Commons, free-licensed)
  var HERO_IMG = {
    "Outbound": "https://commons.wikimedia.org/wiki/Special:FilePath/Sydney_Opera_House_and_Harbour_Bridge_Dusk_(3)_2019-06-21.jpg?width=1600",
    "London": "https://commons.wikimedia.org/wiki/Special:FilePath/London_Skyline_2021.jpg?width=1600",
    "Copenhagen": "https://commons.wikimedia.org/wiki/Special:FilePath/Colorful_Nyhavn_(28544891796).jpg?width=1600",
    "Stockholm": "https://commons.wikimedia.org/wiki/Special:FilePath/Stortorget_i_Gamla_Stan_i_Stockholm.JPG?width=1600",
    "Helsinki": "https://commons.wikimedia.org/wiki/Special:FilePath/Senate_Square_and_Lutheran_Cathedral_in_Helsinki.jpg?width=1600",
    "Seoul": "https://commons.wikimedia.org/wiki/Special:FilePath/View_from_N_Seoul_Tower_a1.jpg?width=1600"
  };
  var HERO_EYEBROW = {
    "Outbound": "In transit",
    "London": "Now in",
    "Copenhagen": "Now in",
    "Stockholm": "Now in",
    "Helsinki": "Now in",
    "Seoul": "Now in"
  };

  // Build itinerary screen with section dividers
  var itinDays = document.getElementById('itinDays');
  var html = "";
  var lastSection = null;
  var legAnchors = [];
  data.days.forEach(function(d){
    if(d.section !== lastSection){
      var id = "leg-" + shortLeg(d.section).toLowerCase().replace(/[^a-z0-9]+/g,'-');
      legAnchors.push({id:id, label: shortLeg(d.section)});
      var subMatch = d.section.match(/\(([^)]+)\)/);
      var sub = subMatch ? subMatch[1] : d.section;
      html += "<div class='section-divider' id='"+id+"'>" +
        "<span class='flag'>"+flagFor(d.section)+"</span>" +
        "<h2>"+esc(shortLeg(d.section))+"</h2>" +
        "<div class='sub'>"+esc(sub)+"</div>" +
        "<div class='rule'></div></div>";
      lastSection = d.section;
    }
    html += dayCard(d);
  });
  itinDays.innerHTML = html;

  // wire notes toggle: show/hide the sibling notes-body block
  itinDays.addEventListener('toggle', function(e){
    if(e.target.matches && e.target.matches('details.notes')){
      var body = e.target.closest('.day').querySelector('[data-notesbody]');
      if(body) body.style.display = e.target.open ? 'block' : 'none';
    }
  }, true);

  // leg nav
  var legNav = document.getElementById('legNav');
  legNav.innerHTML = legAnchors.map(function(a,i){
    return "<a href='#"+a.id+"' data-target='"+a.id+"'"+(i===0?" class='active'":"")+">"+esc(a.label)+"</a>";
  }).join("");

  var itinSticky = document.getElementById('itinSticky');
  legNav.addEventListener('click', function(e){
    var a = e.target.closest('a');
    if(!a) return;
    e.preventDefault();
    Array.prototype.forEach.call(legNav.querySelectorAll('a'), function(el){ el.classList.remove('active'); });
    a.classList.add('active');
    var target = document.getElementById(a.dataset.target);
    if(target){
      var headerH = document.getElementById('topHeader').offsetHeight;
      var y = target.getBoundingClientRect().top + window.scrollY - headerH - itinSticky.offsetHeight - 4;
      window.scrollTo({top:y, behavior:'smooth'});
    }
  });

  // city hero crossfade
  var heroA = document.getElementById('heroImgA');
  var heroB = document.getElementById('heroImgB');
  var heroCity = document.getElementById('heroCity');
  var heroEyebrow = document.getElementById('heroEyebrow');
  var heroUsingA = true;
  var heroLoaded = {};
  function setHero(label){
    var url = HERO_IMG[label];
    if(!url) return;
    var showEl = heroUsingA ? heroB : heroA;
    var hideEl = heroUsingA ? heroA : heroB;
    showEl.onload = function(){ showEl.classList.add('on'); };
    showEl.onerror = function(){ showEl.classList.remove('on'); };
    showEl.classList.remove('on');
    showEl.src = url;
    hideEl.classList.remove('on');
    heroUsingA = !heroUsingA;
    heroCity.textContent = label;
    heroEyebrow.textContent = HERO_EYEBROW[label] || "Now in";
  }
  if(legAnchors.length){ setHero(legAnchors[0].label); }

  // highlight active leg on scroll + update hero
  var sectionEls = legAnchors.map(function(a){ return document.getElementById(a.id); });
  var lastHeroIdx = 0;
  window.addEventListener('scroll', function(){
    var headerH2 = document.getElementById('topHeader').offsetHeight;
    var pos = window.scrollY + headerH2 + itinSticky.offsetHeight + 30;
    var activeIdx = 0;
    sectionEls.forEach(function(el, i){
      if(el && el.offsetTop <= pos) activeIdx = i;
    });
    Array.prototype.forEach.call(legNav.querySelectorAll('a'), function(el, i){
      el.classList.toggle('active', i===activeIdx);
    });
    if(activeIdx !== lastHeroIdx){
      lastHeroIdx = activeIdx;
      setHero(legAnchors[activeIdx].label);
    }
  }, {passive:true});

  // Flights screen
  var fl = document.getElementById('flightsList');
  fl.innerHTML = data.flights.map(function(f){
    return "<div class='flight-card'>" +
      "<div class='fc-top'><span class='fc-route'>"+esc(f.from)+" → "+esc(f.to)+"</span>" +
      "<span class='fc-num'>"+esc(f.flight)+"</span></div>" +
      "<div class='fc-meta'>" +
        "<span><b>"+esc(f.date)+"</b></span>" +
        "<span>"+esc(f.depart)+" → "+esc(f.arrive)+"</span>" +
        "<span>"+esc(f.airline)+"</span>" +
        "<span>"+esc(f.cls)+"</span>" +
        "<span>Ref "+esc(f.ref)+"</span>" +
      "</div>" +
      (f.notes ? "<div class='fc-notes'>"+esc(f.notes)+"</div>" : "") +
      (f.bagAdult ? "<div class='fc-bags'>" +
        "<div class='fc-bag-row'><span class='who'>Adults</span><span class='what'>"+esc(f.bagAdult)+"</span></div>" +
        "<div class='fc-bag-row'><span class='who'>Theodore</span><span class='what'>"+esc(f.bagInfant||"")+"</span></div>" +
        "</div>" : "") +
      "</div>";
  }).join("");

  // Stays screen
  var st = document.getElementById('staysList');
  st.innerHTML = data.stays.map(function(s){
    return "<div class='stay-card'>" +
      "<h3>"+esc(s.hotel)+"</h3>" +
      "<div class='stay-city'>"+esc(s.city)+"</div>" +
      "<div class='stay-dates'>" +
        "<div><div class='k'>Check-in</div><div class='v'>"+esc(s.checkin)+"</div></div>" +
        "<div><div class='k'>Check-out</div><div class='v'>"+esc(s.checkout)+"</div></div>" +
      "</div>" +
      "<div class='stay-cot'>"+esc((s.cot||"").replace(/[✅⚠️]/g,'').trim())+"</div>" +
      "<div class='stay-notes'>"+esc(s.notes)+"</div>" +
      "</div>";
  }).join("");

  // Tips screen
  var tp = document.getElementById('tipsList');
  tp.innerHTML = data.tips.map(function(sec){
    return "<div class='tip-section'>" +
      "<h3>"+esc((sec.section||"").replace(/[\u{1F300}-\u{1FAFF}\u2600-\u27BF]/gu,'').trim())+"</h3>" +
      sec.items.map(function(it){
        return "<div class='tip-item'><div class='t'>"+esc(it.title)+"</div><div class='b'>"+esc(it.body)+"</div></div>";
      }).join("") +
      "</div>";
  }).join("");

  // Bottom nav screen switching
  var bottomNav = document.getElementById('bottomNav');
  bottomNav.addEventListener('click', function(e){
    var btn = e.target.closest('button');
    if(!btn) return;
    var name = btn.dataset.screen;
    Array.prototype.forEach.call(bottomNav.querySelectorAll('button'), function(b){
      b.classList.toggle('active', b===btn);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.screen'), function(s){
      s.classList.toggle('active', s.id === 'screen-'+name);
    });
    window.scrollTo({top:0, behavior:'instant' in window ? 'instant' : 'auto'});
  });

})();
</script>
</body>
</html>
